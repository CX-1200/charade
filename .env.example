# --- Admin access -----------------------------------------------------------
# The password that unlocks Manage (nominees, opening/closing votes, passes).
# REQUIRED in production: with no password set, admin stays locked. (Local
# development falls back to "bestdress".) Use a long, unguessable password —
# and a different one from any other app.
ADMIN_PASSWORD=

# Optional. Secret used to sign admin tokens. Defaults to a value derived from
# ADMIN_PASSWORD, so changing the password invalidates existing tokens.
ADMIN_SECRET=

# --- Database (required in production) --------------------------------------
# Drivers are picked in order: turso > redis > file (writable disk) > memory.
# Vercel's filesystem is read-only, so WITHOUT one of these a Vercel deploy
# falls back to memory and votes are lost between server instances.

# Recommended: Turso (hosted SQLite, free, no card). A separate database from
# any other app is cleanest; sharing one also works (keys start with "vote:").
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Alternative: Upstash Redis / Vercel KV.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Keep-alive --------------------------------------------------------------
# vercel.json runs /api/keepalive daily so a free database is never archived for
# being idle. Set any long random string; only Vercel's cron can then call it.
CRON_SECRET=

# --- Local only --------------------------------------------------------------
# Where the file driver keeps its data. Defaults to ./.data
# VOTE_DATA_DIR=
# Set to 1 to force the in-memory driver (useful for tests).
# VOTE_DISABLE_FILE_STORE=
