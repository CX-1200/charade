# Optional — only needed if you deploy to Vercel and want game state to survive
# across serverless instances / cold starts (strongly recommended for real play).
#
# Works with Upstash Redis (upstash.com, free tier) or Vercel KV / Vercel Redis.
# Create the database, then copy its REST URL + REST token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Vercel Redis integrations inject these names instead — both are read.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
