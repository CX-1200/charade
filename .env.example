# --- Admin access -----------------------------------------------------------
# The shared password that unlocks admin on the home page. Admins create rooms
# and control the round settings; everybody else just picks a name and joins.
# Defaults to "charade" when unset — set a real one before you share the link.
ADMIN_PASSWORD=

# Optional. Secret used to sign admin tokens. Defaults to a value derived from
# ADMIN_PASSWORD, so changing the password invalidates existing tokens.
ADMIN_SECRET=

# --- Storage ----------------------------------------------------------------
# Drivers are picked in order: redis > file (writable disk) > memory.
# Vercel's filesystem is read-only, so WITHOUT these a Vercel deploy falls back
# to memory and the question bank resets on every cold start.
# Works with Upstash Redis or Vercel KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Vercel Redis integrations inject these names instead — both are read.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Where the file driver keeps its data locally. Defaults to ./.data
# CHARADE_DATA_DIR=

# Set to 1 to force the in-memory driver (useful for tests).
# CHARADE_DISABLE_FILE_STORE=
