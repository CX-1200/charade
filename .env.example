# --- Admin access -----------------------------------------------------------
# The shared password that unlocks admin on the home page. Admins create rooms,
# edit the question bank and run rounds; everybody else picks a name and joins.
# Defaults to "charade" when unset — set a real one before you share the link.
ADMIN_PASSWORD=

# Optional. Secret used to sign admin tokens. Defaults to a value derived from
# ADMIN_PASSWORD, so changing the password invalidates existing tokens.
ADMIN_SECRET=

# --- Database (required in production) --------------------------------------
# Drivers are picked in order: turso > redis > file (writable disk) > memory.
# Vercel's filesystem is read-only, so WITHOUT one of these a Vercel deploy
# falls back to memory: rooms go missing between instances and the question
# bank resets on every cold start. Open /setup on the deployment to check.

# Recommended: Turso (hosted SQLite). Free, no card, and a free tier this app
# will not exhaust. Create a database at turso.tech, then:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Alternative: Upstash Redis / Vercel KV. Works the same, but the free tier
# (500k commands/month) covers only a handful of busy game nights.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV integrations inject KV_REST_API_URL / KV_REST_API_TOKEN — also read.)

# --- Keep-alive --------------------------------------------------------------
# vercel.json runs /api/keepalive daily so a free database is never archived for
# being idle. Set any long random string here; Vercel sends it with the cron
# request and the endpoint refuses everyone else.
CRON_SECRET=

# --- Local only --------------------------------------------------------------
# Where the file driver keeps its data. Defaults to ./.data
# CHARADE_DATA_DIR=
# Set to 1 to force the in-memory driver (useful for tests).
# CHARADE_DISABLE_FILE_STORE=
